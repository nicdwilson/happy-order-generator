parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Faker\\Generator\:\:username\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: ../../includes/class-customer.php

		-
			message: '#^PHPDoc tag @var for property Happy_Order_Generator\\Customer\:\:\$instance with type object\|null is not subtype of native type object\.$#'
			identifier: property.phpDocType
			count: 1
			path: ../../includes/class-customer.php

